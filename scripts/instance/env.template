# ComplyNex SECONDARY instance configuration — written by scripts/instance/create_instance.sh (chmod 600).
# The placeholders are filled in by the script; secrets are generated on the server and never printed.
FLASK_ENV=production
SECRET_KEY=__SECRET_KEY__
ENCRYPTION_KEY=__ENCRYPTION_KEY__
APP_URL=https://__HOST__
MAIN_HOSTS=__HOST__,localhost,127.0.0.1
# what this instance offers (utils/instance_profile.py) and its upload quota
CX_INSTANCE_PROFILE=__PROFILE__
CX_UPLOAD_QUOTA_MB=__QUOTA_MB__
CX_UPLOAD_DIR=__INST__/uploads
DB_TYPE=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=__DB__
POSTGRES_USER=__ROLE__
POSTGRES_PASSWORD=__DB_PASS__
DATABASE_URI=postgresql://__ROLE__:__DB_PASS__@127.0.0.1:5432/__DB__
REDIS_URL=redis://localhost:6379/__REDIS_DB__
# no search index, news API or eKYC in a governance instance
ELASTICSEARCH_URL=
NEWSAPI_ENABLED=false
# outgoing mail: off until the owner configures a sender for this instance
EMAIL_MOCK_MODE=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_DEFAULT_SENDER=
EMAIL_USER=
EMAIL_PASS=

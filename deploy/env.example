# ComplyNex instance configuration. Copy to .env (chmod 600) — install_server.sh generates one.
FLASK_ENV=production
SECRET_KEY=__generate__
APP_URL=https://cms.example.local
DB_TYPE=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=complynex_db
POSTGRES_USER=complynex
POSTGRES_PASSWORD=__generate__
DATABASE_URI=postgresql://complynex:__same_password__@127.0.0.1:5432/complynex_db
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX_WATCHLIST=aml_watchlist
ES_INDEX_BLACKLIST=aml_blacklist
ES_USERNAME=complynex_app
ES_PASSWORD=__generate__
# Fernet key for eKYC files at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
EKYC_ENCRYPTION_KEY_V1=__generate__
# Outgoing mail (internal relay on a closed network)
MAIL_SERVER=
MAIL_PORT=587
MAIL_DEFAULT_SENDER=
EMAIL_USER=
EMAIL_PASS=
EMAIL_MOCK_MODE=true
# Adverse media through an external news API: leave disabled on an offline network
NEWSAPI_ENABLED=false
NEWSAPI_KEY=

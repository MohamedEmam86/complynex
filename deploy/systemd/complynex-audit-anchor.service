[Unit]
Description=ComplyNex audit-trail integrity check and daily checkpoint (P6-5)
After=network.target postgresql.service

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
Environment="PATH=/var/www/complynex/venv/bin"
EnvironmentFile=/var/www/complynex/.env
ExecStart=/var/www/complynex/venv/bin/python /var/www/complynex/scripts/audit_anchor.py
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/complynex/logs

[Unit]
Description=ComplyNex Unified Case Registry Sync + SLA Escalation
After=network.target postgresql.service

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
Environment="PATH=/var/www/complynex/venv/bin"
ExecStart=/var/www/complynex/venv/bin/python scripts/sync_cases.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/complynex/logs

[Unit]
Description=ComplyNex Elasticsearch Incremental Sync
After=network.target postgresql.service elasticsearch.service

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
Environment="PATH=/var/www/complynex/venv/bin"
EnvironmentFile=/var/www/complynex/.env
ExecStart=/var/www/complynex/venv/bin/python /var/www/complynex/scripts/es_incremental_sync.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/complynex/logs

# Not installed or enabled automatically. To enable (demo instance):
#   sudo cp deploy/systemd/complynex-demo-regcontrols-queue.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now complynex-demo-regcontrols-queue.timer
# Needs scripts/regcontrols_process_queue.py deployed to /var/www/complynex-demo first.
[Unit]
Description=Process queued ComplyNex DEMO control runs every 5 minutes

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target

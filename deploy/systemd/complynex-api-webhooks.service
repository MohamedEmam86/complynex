[Unit]
Description=ComplyNex API webhooks (emit + deliver signed events)
After=network.target postgresql.service

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
Environment="PATH=/var/www/complynex/venv/bin"
ExecStart=/var/www/complynex/venv/bin/python scripts/api_webhook_dispatch.py
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/complynex/logs

[Unit]
Description=ComplyNex dual-use control lists: check the official publishers and load changed lists
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
Environment="PATH=/var/www/complynex/venv/bin"
EnvironmentFile=/var/www/complynex/.env
# Downloads only from the official publishers (EU Publications Office / CELLAR, eCFR, OPCW, European
# Commission). A list whose content did not change is skipped; a blocked download is recorded and shown to
# the superadmin on Dual-use goods > List updates (upload the file there).
ExecStart=/var/www/complynex/venv/bin/python /var/www/complynex/scripts/dualuse/import_lists.py --apply --scheduled --who scheduled
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/complynex/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Unit]
Description=ComplyNex Risk & Internal Audit daily escalation

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
Environment="PATH=/var/www/complynex/venv/bin"
ExecStart=/var/www/complynex/venv/bin/python scripts/risk_audit_escalation.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/complynex/logs

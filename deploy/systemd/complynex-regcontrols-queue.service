[Unit]
Description=ComplyNex regulatory controls: process queued control runs (rc_run_queue)
After=network.target postgresql.service

[Service]
Type=oneshot
User=complynex
Group=complynex
WorkingDirectory=/var/www/complynex
ExecStart=/var/www/complynex/venv/bin/python scripts/regcontrols_process_queue.py
TimeoutStartSec=3600

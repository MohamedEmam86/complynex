#: aml/routes.py:398
#, python-format
msgid "UBO structure for \"%(company)s\" has been verified against Chamber of Commerce records."
msgstr "تم التحقق من هيكل الملكية المستفيدة النهائية لـ\"%(company)s\" مقابل سجلات الغرفة التجارية."

#: aml/routes.py:801
#, python-format
msgid "Escalated. %(n)d compliance staff notified."
msgstr "تم التصعيد. تم إخطار %(n)d من موظفي الامتثال."

#: aml/routes.py:804
msgid "Escalated, but no other compliance officer exists to notify."
msgstr "تم التصعيد، لكن لا يوجد ضابط امتثال آخر لإخطاره."

#: aml/routes.py:810
msgid "Alert escalated, but notifying the team failed."
msgstr "تم تصعيد التنبيه، لكن فشل إخطار الفريق."


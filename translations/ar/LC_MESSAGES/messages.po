#: templates/whistleblowing/anonymous_info.html:134
msgid "Compliance team reviews and investigates your report."
msgstr "يقوم فريق الامتثال بمراجعة والتحقيق في تقريرك."

#: templates/whistleblowing/anonymous_info.html:145
msgid "Use your code to see updates and resolution."
msgstr "استخدم رمزك لمشاهدة التحديثات والحل."

#: templates/whistleblowing/anonymous_info.html:155
